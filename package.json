{
  "name": "@wazoo/cli",
  "version": "0.1.0",
  "description": "Command-line interface for the Wazoo Platform",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "bin": {
    "wazoo": "./bin/wazoo.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "format": "prettier \"src/**/*.ts\" --write",
    "format:check": "prettier \"src/**/*.ts\" --check",
    "lint": "eslint ."
  },
  "keywords": [
    "wazoo",
    "cli",
    "memory",
    "worlds",
    "agentic-ai"
  ],
  "license": "MIT",
  "dependencies": {
    "@wazoo/client": "npm:@jsr/wazoo__client@^0.3.1",
    "cfonts": "^3.3.1",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.1.1",
    "eslint": "^9.20.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.24.0"
  }
}
